# Copy to .env.local for local dev, and set the same keys in Netlify:
# Site configuration > Environment variables. Vite only exposes vars
# prefixed with VITE_ to the browser.

# Optional. A Google Form share link. If set, every "Early access" button
# opens it in a new tab. If empty, the buttons go to the built-in /signup
# page, which posts to Netlify Forms instead.
VITE_FORM_URL=

# Optional. Leave empty for now: the app falls back to the bundled seed data
# in src/data/profiles.json. Set it to /api once the Python service is live
# and the /api/* proxy in netlify.toml is switched on.
VITE_API_URL=
